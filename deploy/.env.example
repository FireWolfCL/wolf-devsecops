# =============================================================================
# deploy/.env.example — copia a deploy/.env (ignorado por git) y rellena.
# -----------------------------------------------------------------------------
# Tokens de las fuentes. El projects.yaml solo referencia el NOMBRE de estas
# variables (token_env); los valores viven aquí, nunca en el YAML ni en el repo.
# =============================================================================

# GitHub: Personal Access Token (classic) o fine-grained con permiso de lectura
# de Actions en los repos a monitorear.
GITHUB_TOKEN=

# DefectDojo (desde F3): API v2 Key.
DEFECTDOJO_TOKEN=

# SonarQube (desde F4): token de análisis/usuario.
SONAR_TOKEN=

# Orígenes CORS permitidos para el frontend.
WOLF_CORS_ORIGINS=http://localhost:5173
