# =============================================================================
# deploy/.env.example — plantilla / template
# -----------------------------------------------------------------------------
# ES: Normalmente NO necesitas tocar esto a mano: `bash deploy/install.sh` genera
#     deploy/.env con secretos aleatorios. Usa esta plantilla solo para un setup
#     manual. deploy/.env está gitignored: nunca se comitea.
# EN: You usually DON'T edit this by hand: `bash deploy/install.sh` generates
#     deploy/.env with random secrets. Use this template only for a manual setup.
#     deploy/.env is gitignored: never committed.
#
# Generar secretos a mano / generate secrets by hand:
#   WOLF_JWT_SECRET      → openssl rand -base64 48
#   WOLF_MFA_FERNET_KEY  → openssl rand -base64 32 | tr '+/' '-_'
#   *_PASSWORD           → openssl rand -base64 18
# =============================================================================

# ── Obligatorios del backend / mandatory backend secrets ─────────────────────
WOLF_JWT_SECRET=                      # firma de los JWT / JWT signing key
WOLF_MFA_FERNET_KEY=                  # cifra los secretos TOTP / encrypts TOTP secrets
WOLF_ADMIN_USERNAME=admin             # primer admin / first admin
WOLF_ADMIN_PASSWORD=                  # clave del primer login / first-login password
WOLF_ADMIN_EMAIL=                     # opcional / optional

# ── BD internas / internal databases (tienen default; mejor aleatorizar) ─────
POSTGRES_PASSWORD=                    # Postgres de Wolf / Wolf's Postgres (default: wolf)
SONAR_DB_PASSWORD=                    # Postgres de SonarQube (default: sonar)
DD_DB_PASSWORD=                       # Postgres de DefectDojo (default: defectdojo)

# ── Opcionales / optional ────────────────────────────────────────────────────
WOLF_AI_ENABLED=false                 # reviewer IA (se activa en /admin/ia) / AI reviewer
WOLF_CORS_ORIGINS=http://localhost:8088

# ── Tokens de las fuentes / source tokens ────────────────────────────────────
# ES: Vacíos. Los rellena el panel (/admin/integraciones) o provision-sources.sh.
# EN: Empty. Filled by the panel (/admin/integrations) or provision-sources.sh.
GITHUB_TOKEN=                         # PAT con lectura de Actions / read Actions
DEFECTDOJO_TOKEN=
SONAR_TOKEN=
HARBOR_TOKEN=
TRIVY_TOKEN=
