# =============================================================================
# config/projects.yaml — qué proyectos muestra Wolf DevSecOps y de dónde lee
# -----------------------------------------------------------------------------
# Copia este archivo a config/projects.yaml y ajústalo. El projects.yaml real
# NO lleva tokens: los tokens van por variables de entorno (ver deploy/.env),
# y aquí solo se referencian por nombre de variable.
#
# Así cualquier equipo apunta Wolf DevSecOps a SUS proyectos sin tocar código.
# =============================================================================

# Fuentes de datos disponibles. Cada una se habilita con sus credenciales por
# entorno; si no defines una fuente, el dashboard simplemente no la muestra.
sources:
  github:
    api_url: "https://api.github.com"
    token_env: "GITHUB_TOKEN"        # nombre de la env var, no el valor
  defectdojo:
    base_url: "http://localhost:8080"
    token_env: "DEFECTDOJO_TOKEN"
  sonarqube:
    base_url: "http://localhost:9000"
    token_env: "SONAR_TOKEN"
  # GitLab como forge alterno (CI por pipelines + releases). Usa github O gitlab por
  # proyecto; si defines ambos, gana GitHub. base_url = instancia (se le añade /api/v4).
  # gitlab:
  #   base_url: "https://gitlab.com"
  #   token_env: "GITLAB_TOKEN"

# Proyectos a mostrar en la consola.
projects:
  - key: "wolf-cloud"
    name: "Wolf-Cloud"
    github:
      repo: "FireWolfCL/Wolf-Cloud"
      ci_workflow: "ci.yml"
    defectdojo:
      product: "Wolf-Cloud"
    sonarqube:
      project_key: "wolf-cloud"

  # Añade los tuyos. Ejemplo de un proyecto que solo usa GitHub + DefectDojo:
  # - key: "mi-proyecto"
  #   name: "Mi Proyecto"
  #   github:
  #     repo: "mi-org/mi-repo"
  #     ci_workflow: "ci.yml"
  #   defectdojo:
  #     product: "Mi Proyecto"

  # Ejemplo con GitLab como forge (CI + releases desde GitLab en vez de GitHub):
  # - key: "mi-proyecto-gl"
  #   name: "Mi Proyecto GL"
  #   gitlab:
  #     project: "mi-grupo/mi-repo"   # ruta completa o id numérico
  #     ref: "main"                   # opcional: rama para filtrar pipelines
  #   sonarqube:
  #     project_key: "mi-proyecto-gl"
